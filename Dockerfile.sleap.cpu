# Dockerfile.sleap.cpu
#
# This Dockerfile addresses best practices for Kasm-based CPU SLEAP usage.
# It:
#   1. Removes system-level python3-pip in favor of Conda's environment.
#   2. Pins a consistent Python version in conda (3.9 here, can revert to 3.7 if needed).
#   3. Switches to user 1000:1000 to match Kasm's typical user.
#   4. Installs pinned SLEAP, ensuring version compatibility.
#   5. Keeps the rest of your desired features (GUI environment, Jupyter, etc.).

FROM kasmweb/desktop-deluxe:1.15.0-rolling

ENV DEBIAN_FRONTEND=noninteractive

# Make sure we have root privileges for apt operations
USER root

# 1. Install dependencies and rclone
#    Omitting python3-pip from apt-get to avoid potential system vs. conda Python conflicts.
RUN apt-get update && apt-get install -y \
    wget \
    git \
    python3-dev \
    rclone \
    && rm -rf /var/lib/apt/lists/*

# 2. Set known GUI login credentials (kasm-user/kasmvnc)
RUN echo "kasm-user:kasmvnc" | chpasswd

# 3. Install Miniconda to /opt/conda
ENV CONDA_DIR=/opt/conda
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    /bin/bash /tmp/miniconda.sh -b -p ${CONDA_DIR} && \
    rm /tmp/miniconda.sh

# Ensure conda is on PATH
ENV PATH=${CONDA_DIR}/bin:$PATH

# 4. Create sleap-data directory and conda directories with correct permissions
RUN mkdir -p /home/kasm-user/sleap-data && \
    mkdir -p /home/kasm-user/.conda/envs && \
    mkdir -p ${CONDA_DIR}/envs && \
    chown -R 1000:1000 /home/kasm-user/sleap-data && \
    chown -R 1000:1000 /home/kasm-user/.conda && \
    chown -R 1000:1000 ${CONDA_DIR}

# 5. Create conda configuration to use home directory for envs
RUN mkdir -p /home/kasm-user/.conda && \
    echo "envs_dirs:" > /home/kasm-user/.condarc && \
    echo "  - /home/kasm-user/.conda/envs" >> /home/kasm-user/.condarc && \
    echo "  - ${CONDA_DIR}/envs" >> /home/kasm-user/.condarc && \
    chown -R 1000:1000 /home/kasm-user/.conda /home/kasm-user/.condarc

# Set working directory under kasm-user
WORKDIR /home/kasm-user/sleap

# 6. Switch to user for conda operations
USER 1000:1000

# Create and activate sleap environment with pinned Python
RUN /opt/conda/bin/conda create -y -n sleap python=3.9 && \
    /opt/conda/bin/conda clean -ya

# 7. Copy pypi_requirements.txt if it exists, otherwise create it
USER root
RUN echo "numpy>=1.18.0,<1.24.0\npandas>=1.0.0\nopencv-python>=4.5.0\nscipy>=1.4.0\nh5py>=2.10.0\ntables>=3.6.0\nscikit-image>=0.17.0\nseaborn>=0.11.0" > /home/kasm-user/sleap/pypi_requirements.txt && \
    chown 1000:1000 /home/kasm-user/sleap/pypi_requirements.txt
USER 1000:1000

# Install pinned SLEAP plus Jupyter
RUN /bin/bash -c "\
    source /opt/conda/etc/profile.d/conda.sh && \
    conda activate sleap && \
    pip install -r /home/kasm-user/sleap/pypi_requirements.txt && \
    pip install sleap[pypi]==1.4.1 jupyterlab jupyter-server-proxy\
    "

# 8. Fix LD_LIBRARY_PATH on conda activation
USER root
RUN mkdir -p /home/kasm-user/.conda/envs/sleap/etc/conda/activate.d && \
    echo '#!/bin/sh' > /home/kasm-user/.conda/envs/sleap/etc/conda/activate.d/env_vars.sh && \
    echo 'export LD_LIBRARY_PATH=/home/kasm-user/.conda/envs/sleap/lib:$LD_LIBRARY_PATH' >> /home/kasm-user/.conda/envs/sleap/etc/conda/activate.d/env_vars.sh && \
    chmod +x /home/kasm-user/.conda/envs/sleap/etc/conda/activate.d/env_vars.sh && \
    chown -R 1000:1000 /home/kasm-user/.conda
USER 1000:1000

# 9. Disable Jupyter token/password
RUN mkdir -p /home/kasm-user/.jupyter && \
    echo "c.ServerApp.token = ''" > /home/kasm-user/.jupyter/jupyter_server_config.py && \
    echo "c.ServerApp.password = ''" >> /home/kasm-user/.jupyter/jupyter_server_config.py

# 10. Create desktop launcher script
RUN echo "#!/bin/bash" > /home/kasm-user/sleap/start_gui.sh && \
    echo "cd /home/kasm-user/sleap-data" >> /home/kasm-user/sleap/start_gui.sh && \
    echo "source /opt/conda/etc/profile.d/conda.sh" >> /home/kasm-user/sleap/start_gui.sh && \
    echo "conda activate sleap" >> /home/kasm-user/sleap/start_gui.sh && \
    echo "jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root &" >> /home/kasm-user/sleap/start_gui.sh && \
    echo "echo 'To run SLEAP GUI, use sleap-label in terminal'" >> /home/kasm-user/sleap/start_gui.sh && \
    echo "sleep infinity" >> /home/kasm-user/sleap/start_gui.sh && \
    chmod +x /home/kasm-user/sleap/start_gui.sh

# 11. Desktop shortcut for sleap-label GUI
USER root
RUN echo "[Desktop Entry]\nVersion=1.0\nName=SLEAP\nComment=Launch SLEAP GUI\nExec=bash -c 'cd /home/kasm-user/sleap-data && /opt/conda/bin/conda run -n sleap sleap-label'\nTerminal=false\nType=Application\nIcon=utilities-terminal\nCategories=Science;" > /home/kasm-user/Desktop/sleap.desktop && \
    chmod +x /home/kasm-user/Desktop/sleap.desktop && \
    chown 1000:1000 /home/kasm-user/Desktop/sleap.desktop
USER 1000:1000

# 12. Expose ports for Jupyter (8888) and noVNC Kasm desktop (6901)
EXPOSE 8888 6901

# 13. Default command
CMD ["/bin/bash", "/home/kasm-user/sleap/start_gui.sh"]
