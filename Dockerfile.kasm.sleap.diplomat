# Use kasmweb's preconfigured desktop environment base image
FROM kasmweb/ubuntu-jammy-desktop:1.16.0
USER root

# Fix the syntax error (remove space after equals sign)
ENV HOME=/home/kasm-default-profile
ENV STARTUPDIR=/dockerstartup
ENV INST_SCRIPTS=$STARTUPDIR/install
WORKDIR $HOME

# KasmVNC environment and authentication configuration
ENV VNC_PW=password
ENV KASM_PASSWORD=password
ENV KASM_USER=kasm_user
ENV VNC_RESOLUTION=1920x1080
ENV SKIP_CLEAN=true
ENV MAXIMIZE_WEBCLIENT=true

###### Customize the container Here ######

# Set non-interactive mode for apt
ENV DEBIAN_FRONTEND=noninteractive

# Install additional system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    git \
    vim \
    software-properties-common \
    build-essential \
    python3-dev \
    python3-pip \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgtk-3-dev \
    libglib2.0-dev \
    freeglut3-dev \
    libsm6 \
    libxext6 \
    libxrender1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Miniconda to /opt/conda
ENV CONDA_DIR=/opt/conda
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    /bin/bash /tmp/miniconda.sh -b -p ${CONDA_DIR} && \
    rm /tmp/miniconda.sh
ENV PATH=${CONDA_DIR}/bin:$PATH

# Create necessary directories
RUN mkdir -p /home/kasm-user/sleap-data && \
    mkdir -p /home/kasm-user/Desktop && \
    chown -R 1000:1000 /home/kasm-user/sleap-data && \
    chown -R 1000:1000 /home/kasm-user/Desktop

# Create the conda channels configuration
RUN mkdir -p /root/.conda && \
    conda config --file /root/.condarc --add channels conda-forge && \
    conda config --file /root/.condarc --add channels nvidia && \
    conda config --file /root/.condarc --add channels sleap/label/dev && \
    conda config --file /root/.condarc --add channels sleap && \
    conda config --file /root/.condarc --add channels anaconda

# Install mamba for faster package management
RUN conda install -c conda-forge mamba -y

# Copy YAML files for each environment
COPY SLEAP.yaml $HOME/sleap.yaml
COPY DIPLOMAT.yaml $HOME/diplomat.yaml

# Create SLEAP environment (Python 3.7 required)
RUN mamba env create -f $HOME/sleap.yaml && \
    mamba clean -ya && \
    /bin/bash -c "source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate sleap && \
    pip install notebook jupyterlab jupyter-server-proxy"

# Create DIPLOMAT environment (Python 3.9 required)
RUN mamba env create -f $HOME/diplomat.yaml && \
    mamba clean -ya && \
    /bin/bash -c "source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate diplomat && \
    pip install notebook jupyterlab jupyter-server-proxy"

# Set up the proper LD_LIBRARY_PATH for GPU libraries for SLEAP
RUN mkdir -p ${CONDA_DIR}/envs/sleap/etc/conda/activate.d && \
    echo '#!/bin/sh' >> ${CONDA_DIR}/envs/sleap/etc/conda/activate.d/sleap_activate.sh && \
    echo 'export SLEAP_OLD_LD_LIBRARY_PATH=$LD_LIBRARY_PATH' >> ${CONDA_DIR}/envs/sleap/etc/conda/activate.d/sleap_activate.sh && \
    echo 'export LD_LIBRARY_PATH=${CONDA_DIR}/envs/sleap/lib:$LD_LIBRARY_PATH' >> ${CONDA_DIR}/envs/sleap/etc/conda/activate.d/sleap_activate.sh && \
    chmod +x ${CONDA_DIR}/envs/sleap/etc/conda/activate.d/sleap_activate.sh

# Set up the proper LD_LIBRARY_PATH for GPU libraries for DIPLOMAT
RUN mkdir -p ${CONDA_DIR}/envs/diplomat/etc/conda/activate.d && \
    echo '#!/bin/sh' >> ${CONDA_DIR}/envs/diplomat/etc/conda/activate.d/diplomat_activate.sh && \
    echo 'export DIPLOMAT_OLD_LD_LIBRARY_PATH=$LD_LIBRARY_PATH' >> ${CONDA_DIR}/envs/diplomat/etc/conda/activate.d/diplomat_activate.sh && \
    echo 'export LD_LIBRARY_PATH=${CONDA_DIR}/envs/diplomat/lib:$LD_LIBRARY_PATH' >> ${CONDA_DIR}/envs/diplomat/etc/conda/activate.d/diplomat_activate.sh && \
    chmod +x ${CONDA_DIR}/envs/diplomat/etc/conda/activate.d/diplomat_activate.sh

# Create desktop shortcut for SLEAP
RUN echo "[Desktop Entry]\nVersion=1.0\nName=SLEAP\nComment=SLEAP Animal Pose Tracking\nExec=bash -c 'source ${CONDA_DIR}/etc/profile.d/conda.sh && conda activate sleap && cd /home/kasm-user/sleap-data && sleap-label'\nTerminal=false\nType=Application\nIcon=utilities-terminal\nCategories=Science;" > /home/kasm-user/Desktop/sleap.desktop && \
    chmod +x /home/kasm-user/Desktop/sleap.desktop && \
    chown 1000:1000 /home/kasm-user/Desktop/sleap.desktop

# Create desktop shortcut for DIPLOMAT
RUN echo "[Desktop Entry]\nVersion=1.0\nName=DIPLOMAT\nComment=DIPLOMAT Animal Tracking\nExec=bash -c 'source ${CONDA_DIR}/etc/profile.d/conda.sh && conda activate diplomat && cd /home/kasm-user/sleap-data && python -m diplomat'\nTerminal=false\nType=Application\nIcon=utilities-terminal\nCategories=Science;" > /home/kasm-user/Desktop/diplomat.desktop && \
    chmod +x /home/kasm-user/Desktop/diplomat.desktop && \
    chown 1000:1000 /home/kasm-user/Desktop/diplomat.desktop

# Create integration script to transfer data between SLEAP and DIPLOMAT
RUN echo '#!/bin/bash' > /home/kasm-user/sleap_to_diplomat.sh && \
    echo 'source ${CONDA_DIR}/etc/profile.d/conda.sh' >> /home/kasm-user/sleap_to_diplomat.sh && \
    echo 'SLEAP_FILE=$1' >> /home/kasm-user/sleap_to_diplomat.sh && \
    echo 'OUTPUT_DIR=/home/kasm-user/sleap-data/diplomat_results' >> /home/kasm-user/sleap_to_diplomat.sh && \
    echo 'mkdir -p $OUTPUT_DIR' >> /home/kasm-user/sleap_to_diplomat.sh && \
    echo 'echo "Step 1: Processing SLEAP data..."' >> /home/kasm-user/sleap_to_diplomat.sh && \
    echo 'conda activate sleap' >> /home/kasm-user/sleap_to_diplomat.sh && \
    echo 'sleap-convert "$SLEAP_FILE" --format h5 --output "$OUTPUT_DIR/sleap_converted.h5"' >> /home/kasm-user/sleap_to_diplomat.sh && \
    echo 'echo "Step 2: Running DIPLOMAT analysis..."' >> /home/kasm-user/sleap_to_diplomat.sh && \
    echo 'conda activate diplomat' >> /home/kasm-user/sleap_to_diplomat.sh && \
    echo 'python -m diplomat process "$OUTPUT_DIR/sleap_converted.h5"' >> /home/kasm-user/sleap_to_diplomat.sh && \
    chmod +x /home/kasm-user/sleap_to_diplomat.sh && \
    chown 1000:1000 /home/kasm-user/sleap_to_diplomat.sh

# Create desktop shortcut for the integration script
RUN echo "[Desktop Entry]\nVersion=1.0\nName=SLEAP to DIPLOMAT\nComment=Process SLEAP data with DIPLOMAT\nExec=bash -c 'cd /home/kasm-user/sleap-data && bash /home/kasm-user/sleap_to_diplomat.sh %f'\nTerminal=true\nType=Application\nIcon=utilities-terminal\nCategories=Science;" > /home/kasm-user/Desktop/sleap-to-diplomat.desktop && \
    chmod +x /home/kasm-user/Desktop/sleap-to-diplomat.desktop && \
    chown 1000:1000 /home/kasm-user/Desktop/sleap-to-diplomat.desktop

# Create multi-kernel Jupyter setup
RUN echo '#!/bin/bash' > /home/kasm-user/setup_jupyter_kernels.sh && \
    echo 'source ${CONDA_DIR}/etc/profile.d/conda.sh' >> /home/kasm-user/setup_jupyter_kernels.sh && \
    echo 'conda activate sleap' >> /home/kasm-user/setup_jupyter_kernels.sh && \
    echo 'pip install ipykernel' >> /home/kasm-user/setup_jupyter_kernels.sh && \
    echo 'python -m ipykernel install --user --name sleap --display-name "SLEAP (Python 3.7)"' >> /home/kasm-user/setup_jupyter_kernels.sh && \
    echo 'conda activate diplomat' >> /home/kasm-user/setup_jupyter_kernels.sh && \
    echo 'pip install ipykernel' >> /home/kasm-user/setup_jupyter_kernels.sh && \
    echo 'python -m ipykernel install --user --name diplomat --display-name "DIPLOMAT (Python 3.9)"' >> /home/kasm-user/setup_jupyter_kernels.sh && \
    chmod +x /home/kasm-user/setup_jupyter_kernels.sh && \
    chown 1000:1000 /home/kasm-user/setup_jupyter_kernels.sh && \
    /bin/bash -c "bash /home/kasm-user/setup_jupyter_kernels.sh"

# Add Jupyter shortcut with multi-kernel support
RUN echo "[Desktop Entry]\nVersion=1.0\nName=Jupyter Lab\nComment=Jupyter Lab with SLEAP and DIPLOMAT kernels\nExec=bash -c 'source ${CONDA_DIR}/etc/profile.d/conda.sh && conda activate sleap && cd /home/kasm-user/sleap-data && jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root --NotebookApp.token=\"\"'\nTerminal=false\nType=Application\nIcon=firefox\nCategories=Science;" > /home/kasm-user/Desktop/jupyter.desktop && \
    chmod +x /home/kasm-user/Desktop/jupyter.desktop && \
    chown 1000:1000 /home/kasm-user/Desktop/jupyter.desktop

# Create a menu category for all animal tracking tools
RUN mkdir -p /home/kasm-user/.local/share/applications && \
    echo "[Desktop Entry]\nType=Directory\nName=Animal Tracking\nIcon=folder" > /home/kasm-user/.local/share/applications/animal-tracking.directory && \
    mkdir -p /home/kasm-user/.local/share/desktop-directories && \
    cp /home/kasm-user/.local/share/applications/animal-tracking.directory /home/kasm-user/.local/share/desktop-directories/ && \
    mkdir -p /home/kasm-user/.config/menus/applications-merged && \
    echo '<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN" "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">\n<Menu>\n<Name>Applications</Name>\n<Menu>\n<Name>Animal Tracking</Name>\n<Directory>animal-tracking.directory</Directory>\n<Include>\n<Filename>sleap.desktop</Filename>\n<Filename>diplomat.desktop</Filename>\n<Filename>sleap-to-diplomat.desktop</Filename>\n</Include>\n</Menu>\n</Menu>' > /home/kasm-user/.config/menus/applications-merged/animal-tracking.menu && \
    chown -R 1000:1000 /home/kasm-user/.local && \
    chown -R 1000:1000 /home/kasm-user/.config

# Fix custom startup script integration
RUN mkdir -p /etc/kasmvnc/ && \
    echo '#!/bin/bash' > /etc/kasmvnc/kasmvnc.startup && \
    echo 'source ${CONDA_DIR}/etc/profile.d/conda.sh' >> /etc/kasmvnc/kasmvnc.startup && \
    echo 'conda activate sleap' >> /etc/kasmvnc/kasmvnc.startup && \
    echo 'cd /home/kasm-user/sleap-data' >> /etc/kasmvnc/kasmvnc.startup && \
    echo 'jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root --NotebookApp.token="" &' >> /etc/kasmvnc/kasmvnc.startup && \
    chmod +x /etc/kasmvnc/kasmvnc.startup

# Remove the problematic custom_startup.sh setup
RUN rm -f /dockerstartup/custom_startup.sh || true
RUN rm -f /etc/kasmvnc/custom_startup.sh || true

# Create startup script for jupyter
RUN echo '#!/bin/bash' > /home/kasm-user/start_jupyter.sh && \
    echo 'source ${CONDA_DIR}/etc/profile.d/conda.sh' >> /home/kasm-user/start_jupyter.sh && \
    echo 'conda activate sleap' >> /home/kasm-user/start_jupyter.sh && \
    echo 'cd /home/kasm-user/sleap-data' >> /home/kasm-user/start_jupyter.sh && \
    echo 'jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root --NotebookApp.token="" &' >> /home/kasm-user/start_jupyter.sh && \
    chmod +x /home/kasm-user/start_jupyter.sh && \
    chown 1000:1000 /home/kasm-user/start_jupyter.sh

# Create README file for user guidance
RUN echo '# SLEAP and DIPLOMAT Integration\n\nThis container provides both SLEAP (Python 3.7) and DIPLOMAT (Python 3.9) in separate environments.\n\n## Desktop Shortcuts:\n- **SLEAP**: Launch the SLEAP labeling tool\n- **DIPLOMAT**: Launch the DIPLOMAT tool\n- **SLEAP to DIPLOMAT**: Process SLEAP data with DIPLOMAT\n- **Jupyter Lab**: Access notebooks with both environments available as kernels\n\n## Working with Both Tools:\n\nTo process SLEAP data with DIPLOMAT:\n1. Create your labels in SLEAP\n2. Save your project\n3. Click on the "SLEAP to DIPLOMAT" shortcut\n4. Enter the path to your SLEAP file when prompted\n\nIn Jupyter notebooks, you can select either the SLEAP or DIPLOMAT kernel depending on which tool you need to use.\n' > /home/kasm-user/sleap-data/README.md && \
    chown 1000:1000 /home/kasm-user/sleap-data/README.md

# Expose port for KasmVNC
EXPOSE 6901

###### End Customize the container Here ######

# Fix permissions for the kasm-user profile
RUN mkdir -p /home/kasm-user/.cache/mozilla && \
    mkdir -p /home/kasm-user/.cache/sessions && \
    mkdir -p /home/kasm-user/.cache/dconf && \
    mkdir -p /home/kasm-user/.config && \
    mkdir -p /home/kasm-user/.local/share && \
    chown -R 1000:1000 /home/kasm-user/.cache && \
    chown -R 1000:1000 /home/kasm-user/.config && \
    chown -R 1000:1000 /home/kasm-user/.local && \
    chmod -R 755 /home/kasm-user/.cache && \
    chmod -R 755 /home/kasm-user/.config && \
    chmod -R 755 /home/kasm-user/.local

# Fix permissions for default profile
RUN chown -R 1000:0 $HOME && \
    find $HOME -type d -exec chmod 755 {} \; && \
    find $HOME -type f -exec chmod 644 {} \;

# Set proper home directory
ENV HOME=/home/kasm-user
WORKDIR $HOME
RUN mkdir -p $HOME && chown -R 1000:0 $HOME

# Add volume for data persistence
VOLUME /home/kasm-user/sleap-data

USER 1000
CMD ["--tail-log"]
